NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://vcraft:vcraft_dev_only@localhost:5432/vcraft?schema=public
# Dùng chuỗi ngẫu nhiên dài >=32 ký tự; KHÔNG dùng giá trị ví dụ này ở production.
# Có thể sinh ngẫu nhiên bằng  node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Sau khi sinh xong thì đặt vào đây, và không commit lên git. Đổi tên file .env.example thành .env để sử dụng.
SESSION_SECRET=replace-with-a-long-random-32-plus-character-secret
APP_PUBLIC_URL=http://localhost:5173
TRUST_PROXY=false
