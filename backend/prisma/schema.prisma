generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ARTISAN
  BUYER
}

// Standalone demo baseline. N1 owns the production User model and enum.
enum UserStatus {
  ACTIVE
  INACTIVE
}

enum WorkshopStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  VISIBLE
  HIDDEN
}

enum BatchStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id                String                @id @default(uuid()) @db.Uuid
  email             String                @unique @db.VarChar(255)
  passwordHash      String                @db.VarChar(255)
  fullName          String                @db.VarChar(150)
  phone             String?               @db.VarChar(20)
  role              UserRole
  status            UserStatus            @default(ACTIVE)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  workshop          Workshop?             @relation("Owner")
  reviewedWorkshops Workshop[]            @relation("Reviewer")
  updatedMilestones ProductionMilestone[]
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("session")
}

model Workshop {
  id              String                @id @default(uuid()) @db.Uuid
  ownerId         String                @unique @db.Uuid
  owner           User                  @relation("Owner", fields: [ownerId], references: [id], onDelete: Restrict)
  name            String                @db.VarChar(255)
  slug            String                @unique @db.VarChar(255)
  description     String                @default("")
  history         String                @default("")
  address         String
  latitude        Decimal?              @db.Decimal(9, 6)
  longitude       Decimal?              @db.Decimal(9, 6)
  isOpenForVisit  Boolean               @default(false)
  openingHours    Json                  @default("{}")
  acceptsOrders   Boolean               @default(true)
  status          WorkshopStatus        @default(PENDING)
  rejectionReason String?
  reviewedById    String?               @db.Uuid
  reviewedBy      User?                 @relation("Reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  categories      WorkshopCategory[]
  images          WorkshopImage[]
  certificates    WorkshopCertificate[]
  products        Product[]
  batches         ProductionBatch[]

  @@index([status])
}

model WorkshopCategory {
  workshopId String   @db.Uuid
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([workshopId, categoryId])
  @@index([categoryId])
}

model WorkshopImage {
  id         String   @id @default(uuid()) @db.Uuid
  workshopId String   @db.Uuid
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  imageUrl   String
  thumbUrl   String
  altText    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([workshopId, sortOrder])
}

model WorkshopCertificate {
  id         String    @id @default(uuid()) @db.Uuid
  workshopId String    @db.Uuid
  workshop   Workshop  @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  title      String    @db.VarChar(255)
  issuer     String    @db.VarChar(255)
  issuedAt   DateTime? @db.Date
  fileUrl    String
  createdAt  DateTime  @default(now())

  @@index([workshopId])
}

model Category {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @db.VarChar(255)
  slug      String             @unique @db.VarChar(255)
  workshops WorkshopCategory[]
  products  Product[]
}

model Product {
  id             String         @id @default(uuid()) @db.Uuid
  workshopId     String         @db.Uuid
  workshop       Workshop       @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  categoryId     String         @db.Uuid
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name           String         @db.VarChar(255)
  slug           String         @unique @db.VarChar(255)
  description    String         @default("")
  specifications Json           @default("{}")
  price          Decimal?       @db.Decimal(12, 2)
  status         ProductStatus  @default(HIDDEN)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  images         ProductImage[]
  batches        BatchProduct[]

  @@index([workshopId, categoryId, status])
  @@index([categoryId, status])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String
  thumbUrl  String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model ProductionBatch {
  id          String                @id @default(uuid()) @db.Uuid
  workshopId  String                @db.Uuid
  workshop    Workshop              @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  batchCode   String                @unique @db.VarChar(100)
  name        String                @db.VarChar(255)
  description String                @default("")
  status      BatchStatus           @default(PLANNED)
  isPublic    Boolean               @default(false)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  products    BatchProduct[]
  milestones  ProductionMilestone[]

  @@index([workshopId])
  @@index([workshopId, status])
}

model BatchProduct {
  batchId   String          @db.Uuid
  batch     ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  productId String          @db.Uuid
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int

  @@id([batchId, productId])
  @@index([productId])
}

model ProductionMilestone {
  id          String           @id @default(uuid()) @db.Uuid
  batchId     String           @db.Uuid
  batch       ProductionBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  title       String           @db.VarChar(255)
  description String           @default("")
  orderIndex  Int
  occurredAt  DateTime?
  updatedById String           @db.Uuid
  updatedBy   User             @relation(fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  images      MilestoneImage[]

  @@unique([batchId, orderIndex])
}

model MilestoneImage {
  id          String              @id @default(uuid()) @db.Uuid
  milestoneId String              @db.Uuid
  milestone   ProductionMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  imageUrl    String
  thumbUrl    String
  altText     String?
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())

  @@index([milestoneId, sortOrder])
}
