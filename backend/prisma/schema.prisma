generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ARTISAN
  BUYER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum WorkshopStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  VISIBLE
  HIDDEN
}

enum BatchStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RfqStatus {
  DRAFT
  SENT
  BIDDING
  ACCEPTED
  IN_PRODUCTION
  DELIVERED
}

enum InvitationStatus {
  INVITED
  VIEWED
  BID_SUBMITTED
}

enum BidStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum PlanStatus {
  DRAFT
  PENDING_BUYER
  ACCEPTED
  REJECTED
}

enum OrderStatus {
  IN_PRODUCTION
  READY
  DELIVERED
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum NewsCategory {
  MATERIAL_PRICE
  POWER_OUTAGE
  SUPPORT_POLICY
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(255)
  passwordHash String @db.VarChar(255)
  fullName String @db.VarChar(150)
  phone String? @db.VarChar(20)
  role UserRole
  status UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workshop Workshop? @relation("WorkshopOwner")
  reviewedWorkshops Workshop[] @relation("WorkshopReviewer")
  rfqs Rfq[]
  plans AllocationPlan[]
  orders Order[]
  authoredMilestones ProductionMilestone[]
  invitationsSent RfqInvitation[]
}
model Session {
  sid String @id @db.VarChar(255)
  sess Json
  expire DateTime @db.Timestamp(6)
  @@index([expire])
  @@map("session")
}
model Category {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(255)
  slug String @unique @db.VarChar(255)
  workshops WorkshopCategory[]
  products Product[]
  rfqs Rfq[]
}
model Workshop {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @unique @db.Uuid
  owner User @relation("WorkshopOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  name String @db.VarChar(255)
  slug String @unique @db.VarChar(255)
  description String?
  history String?
  address String
  latitude Decimal? @db.Decimal(9,6)
  longitude Decimal? @db.Decimal(9,6)
  isOpenForVisit Boolean @default(false)
  openingHours Json?
  acceptsOrders Boolean @default(true)
  status WorkshopStatus @default(PENDING)
  rejectionReason String?
  reviewedById String? @db.Uuid
  reviewer User? @relation("WorkshopReviewer", fields: [reviewedById], references: [id])
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  categories WorkshopCategory[]
  images WorkshopImage[]
  certificates WorkshopCertificate[]
  products Product[]
  batches ProductionBatch[]
  invitations RfqInvitation[]
  bids Bid[]
  planItems AllocationPlanItem[]
  tasks ProductionTask[]
  @@index([status])
}
model WorkshopCategory {
  workshopId String @db.Uuid
  categoryId String @db.Uuid
  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  @@id([workshopId, categoryId])
  @@index([categoryId])
}
model WorkshopImage {
  id String @id @default(uuid()) @db.Uuid
  workshopId String @db.Uuid
  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  imageUrl String
  thumbUrl String
  altText String?
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  @@index([workshopId, sortOrder])
}
model WorkshopCertificate {
  id String @id @default(uuid()) @db.Uuid
  workshopId String @db.Uuid
  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  title String @db.VarChar(255)
  issuer String @db.VarChar(255)
  issuedAt DateTime? @db.Date
  fileUrl String
  createdAt DateTime @default(now())
  @@index([workshopId])
}
model Product {
  id String @id @default(uuid()) @db.Uuid
  workshopId String @db.Uuid
  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  categoryId String @db.Uuid
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name String @db.VarChar(255)
  slug String @unique @db.VarChar(255)
  description String?
  specifications Json?
  price Decimal? @db.Decimal(12,2)
  status ProductStatus @default(HIDDEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  images ProductImage[]
  batchProducts BatchProduct[]
  referenceRfqs Rfq[]
  @@index([workshopId, categoryId, status])
  @@index([categoryId, status])
}
model ProductImage {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl String
  thumbUrl String
  altText String?
  sortOrder Int @default(0)
  isPrimary Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([productId, sortOrder])
}
model ProductionBatch {
  id String @id @default(uuid()) @db.Uuid
  workshopId String @db.Uuid
  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  batchCode String @unique @db.VarChar(100)
  name String @db.VarChar(255)
  description String?
  status BatchStatus @default(PLANNED)
  isPublic Boolean @default(false)
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products BatchProduct[]
  milestones ProductionMilestone[]
  tasks ProductionTask[]
  @@index([workshopId, status])
}
model BatchProduct {
  batchId String @db.Uuid
  productId String @db.Uuid
  quantity Int
  batch ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@id([batchId, productId])
  @@index([productId])
}
model ProductionMilestone {
  id String @id @default(uuid()) @db.Uuid
  batchId String @db.Uuid
  batch ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  title String @db.VarChar(255)
  description String?
  orderIndex Int
  occurredAt DateTime?
  updatedById String @db.Uuid
  updatedBy User @relation(fields: [updatedById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  images MilestoneImage[]
  @@unique([batchId, orderIndex])
}
model MilestoneImage {
  id String @id @default(uuid()) @db.Uuid
  milestoneId String @db.Uuid
  milestone ProductionMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  imageUrl String
  thumbUrl String
  altText String?
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  @@index([milestoneId, sortOrder])
}
model Rfq {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(20)
  buyerId String @db.Uuid
  buyer User @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  categoryId String @db.Uuid
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  referenceProductId String? @db.Uuid
  referenceProduct Product? @relation(fields: [referenceProductId], references: [id], onDelete: SetNull)
  title String @db.VarChar(200)
  description String?
  quantity Int
  unit String @default("chiếc") @db.VarChar(30)
  budgetMax Decimal? @db.Decimal(12,2)
  bidDeadline DateTime
  requiredBy DateTime @db.Date
  contactName String @db.VarChar(150)
  contactPhone String? @db.VarChar(20)
  deliveryAddress String @db.VarChar(300)
  status RfqStatus @default(DRAFT)
  sentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invitations RfqInvitation[]
  bids Bid[]
  plans AllocationPlan[]
  order Order?
  @@index([buyerId, status])
  @@index([status])
}
model RfqInvitation {
  id String @id @default(uuid()) @db.Uuid
  rfqId String @db.Uuid
  rfq Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  workshopId String @db.Uuid
  workshop Workshop @relation(fields: [workshopId], references: [id])
  status InvitationStatus @default(INVITED)
  invitedById String? @db.Uuid
  invitedBy User? @relation(fields: [invitedById], references: [id])
  viewedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([rfqId, workshopId])
}
model Bid {
  id String @id @default(uuid()) @db.Uuid
  rfqId String @db.Uuid
  rfq Rfq @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  workshopId String @db.Uuid
  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  quantityOffered Int
  unitPrice Decimal @db.Decimal(12,2)
  leadTimeDays Int
  note String?
  status BidStatus @default(SUBMITTED)
  lockedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  planItems AllocationPlanItem[]
  @@unique([rfqId, workshopId])
}
model AllocationPlan {
  id String @id @default(uuid()) @db.Uuid
  rfqId String @db.Uuid
  rfq Rfq @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  createdById String @db.Uuid
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  status PlanStatus @default(DRAFT)
  totalQuantity Int @default(0)
  totalAmount Decimal @default(0) @db.Decimal(12,2)
  rejectReason String?
  sentAt DateTime?
  decidedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items AllocationPlanItem[]
  order Order?
  @@index([rfqId, status])
}
model AllocationPlanItem {
  id String @id @default(uuid()) @db.Uuid
  planId String @db.Uuid
  plan AllocationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  bidId String @db.Uuid
  bid Bid @relation(fields: [bidId], references: [id], onDelete: Restrict)
  workshopId String @db.Uuid
  workshop Workshop @relation(fields: [workshopId], references: [id])
  quantity Int
  unitPrice Decimal @db.Decimal(12,2)
  lineTotal Decimal @db.Decimal(12,2)
  dueDate DateTime @db.Date
  task ProductionTask?
  @@unique([planId, bidId])
}
model Order {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(20)
  rfqId String @unique @db.Uuid
  rfq Rfq @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  planId String @unique @db.Uuid
  plan AllocationPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  buyerId String @db.Uuid
  buyer User @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  totalAmount Decimal @db.Decimal(12,2)
  status OrderStatus @default(IN_PRODUCTION)
  receivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks ProductionTask[]
  @@index([buyerId, status])
}
model ProductionTask {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  workshopId String @db.Uuid
  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  planItemId String @unique @db.Uuid
  planItem AllocationPlanItem @relation(fields: [planItemId], references: [id], onDelete: Restrict)
  quantity Int
  completedQuantity Int @default(0)
  unitPrice Decimal @db.Decimal(12,2)
  dueDate DateTime @db.Date
  status TaskStatus @default(ASSIGNED)
  progressNote String?
  batchId String? @db.Uuid
  batch ProductionBatch? @relation(fields: [batchId], references: [id])
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([orderId, workshopId])
  @@index([workshopId, status])
}
model News {
  id String @id @default(uuid()) @db.Uuid
  title String @db.VarChar(255)
  slug String @unique @db.VarChar(255)
  content String
  category NewsCategory
  status NewsStatus @default(DRAFT)
  coverUrl String?
  isFeatured Boolean @default(false)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, category, publishedAt])
}
