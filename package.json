{
  "name": "vcraft",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "test": "npm test --workspace backend",
    "build": "npm run build --workspace frontend",
    "check": "npm run check --workspace backend"
  }
}
